#!/usr/bin/env bash
# zed-reload - restart Zed and inject a message into the Agent Panel,
# so an agent thread can continue without human help.
#
# Thin launcher: hands off to zed-reload.ps1 DETACHED (survives Zed's
# death) and returns immediately. Works from any cwd; no hardcoded paths.
#
# Usage:
#   zed-reload [message...]            restart Zed, then send message (default: "continue")
#   zed-reload --send [message...]     send to the running Zed (no restart)
#   zed-reload --watch [message...]    wait for Zed to die/hang, then revive + send
#   zed-reload --check                 print resolved config (foreground)
#   --wait N         seconds before acting (default 6; gives caller time to finish)
#   --settle N       seconds to wait after the window appears (default 10)
#   --project PATH   open PATH instead of relying on session restore
#   --window-title R only target a window whose title matches regex R
#   --watch-timeout N   watch mode: give up after N seconds (default 3600)
#   --unresponsive N    watch mode: also revive if window hangs for N seconds
#   --send-enter / --send-ctrl-enter    force send key (default: auto-detect)
#   --zed-path PATH  explicit Zed.exe location
#
# Log: zed-reload.log next to this script.
set -u
SELF_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
MODE=restart; PRE=6; SETTLE=10; PROJECT=""; WTITLE=""; WATCHTO=3600; UNRESP=0; SENDKEY=""; ZEDPATH=""
MSG_PARTS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --send) MODE=send; shift ;;
    --watch) MODE=watch; shift ;;
    --check) MODE=check; shift ;;
    --wait) PRE="$2"; shift 2 ;;
    --settle) SETTLE="$2"; shift 2 ;;
    --project) PROJECT="$2"; shift 2 ;;
    --window-title) WTITLE="$2"; shift 2 ;;
    --watch-timeout) WATCHTO="$2"; shift 2 ;;
    --unresponsive) UNRESP="$2"; shift 2 ;;
    --send-enter) SENDKEY="-SendEnter"; shift ;;
    --send-ctrl-enter) SENDKEY="-SendCtrlEnter"; shift ;;
    --zed-path) ZEDPATH="$2"; shift 2 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) MSG_PARTS+=("$1"); shift ;;
  esac
done

PS1_WIN="$(cygpath -w "$SELF_DIR/zed-reload.ps1")"
LOG_WIN="$(cygpath -w "$SELF_DIR/zed-reload.log")"

if [[ "$MODE" == "check" ]]; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$PS1_WIN" -Mode check -LogFile "$LOG_WIN"
  exit $?
fi

MSG="continue"
if [[ ${#MSG_PARTS[@]} -gt 0 ]]; then MSG="${MSG_PARTS[*]}"; fi
MSG_FILE="$(mktemp)"
printf '%s' "$MSG" > "$MSG_FILE"
MSG_WIN="$(cygpath -w "$MSG_FILE")"

# Detached launch that survives the terminal (and Zed) dying.
# Encoding note (two failures behind this): `cmd //c start "" powershell ...`
# mangles args under MSYS, and native powershell.exe argv parsing strips only
# DOUBLE quotes, so -File 'C:\path' keeps the single quotes and fails.
# -EncodedCommand (base64 UTF-16LE) bypasses every quoting layer.
# INNER is a real PowerShell snippet, so single quotes are correct there.
# Values with " or $ (e.g. --window-title regex) are not supported in it.
INNER="& '$PS1_WIN' -Mode '$MODE' -MessageFile '$MSG_WIN' -PreDelay $PRE -Settle $SETTLE -WatchTimeout $WATCHTO -UnresponsiveSeconds $UNRESP -LogFile '$LOG_WIN'"
[[ -n "$SENDKEY" ]] && INNER="$INNER $SENDKEY"
[[ -n "$PROJECT" ]] && INNER="$INNER -Project '$(cygpath -w "$PROJECT")'"
[[ -n "$WTITLE"  ]] && INNER="$INNER -WindowTitleMatch '$WTITLE'"
[[ -n "$ZEDPATH" ]] && INNER="$INNER -ZedPath '$(cygpath -w "$ZEDPATH")'"

powershell -NoProfile -Command "\$c = [Convert]::ToBase64String([System.Text.Encoding]::Unicode.GetBytes(\"$INNER\")); Start-Process -WindowStyle Hidden -FilePath 'powershell.exe' -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-EncodedCommand',\$c" \
  && echo "zed-reload: launched detached (mode=$MODE, wait=${PRE}s, settle=${SETTLE}s)" \
  || echo "zed-reload: LAUNCH FAILED"
echo "zed-reload: log -> $SELF_DIR/zed-reload.log"
